# Names only — no real values belong in this committed file. Copy to .env.local (already
# git-ignored) and fill in real values there.

# One of: mock | supabase-auth | supabase. Default is "mock".
#   mock          - every provider (Auth + all business data) is mock.
#   supabase-auth - Auth is real Supabase; every other provider stays mock. Transitional
#                   mode for testing real sign-in before business-data providers are ready.
#   supabase      - every provider is real Supabase. Keep this off until every provider
#                   this app uses has a real Supabase implementation — see
#                   docs/current-project-state.md.
NEXT_PUBLIC_DATA_PROVIDER=mock

# Only required once NEXT_PUBLIC_DATA_PROVIDER is supabase-auth or supabase. Safe to expose
# to the browser by design (Supabase's publishable/anon key), but still never commit a real
# value here. Obtain both from the Supabase dashboard: Corebridgex organization ->
# corebridgex-crm project -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Admin Foundation — required only for Admin user-management actions (create user, reset password,
# deactivate/reactivate via the Supabase Auth Admin API). Server-only: never prefix NEXT_PUBLIC_,
# never commit a real value, never log it. Obtain from the Supabase dashboard: Project Settings ->
# API -> service_role secret key. See src/lib/supabase/service-role.ts.
SUPABASE_SERVICE_ROLE_KEY=
