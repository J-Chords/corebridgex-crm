# Names only — no real values belong in this committed file. Copy to .env.local (already
# git-ignored) and fill in real values there.

# "mock" (default) or "supabase". Keep this at "mock" until every provider this app uses has
# a real Supabase implementation — see docs/current-project-state.md.
NEXT_PUBLIC_DATA_PROVIDER=mock

# Only required once NEXT_PUBLIC_DATA_PROVIDER=supabase. Safe to expose to the browser by
# design (Supabase's publishable/anon key), but still never commit a real value here.
# Obtain both from the Supabase dashboard: Corebridgex organization -> corebridgex-crm
# project -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
